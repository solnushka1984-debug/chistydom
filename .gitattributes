# Нормализуем переводы строк: в репозитории храним LF
* text=auto eol=lf

# Бинарные файлы не трогаем
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Файлы сборки и локи не диффим
pnpm-lock.yaml -diff linguist-generated=true
*.tsbuildinfo -diff linguist-generated=true
**/src/generated/** -diff linguist-generated=true
